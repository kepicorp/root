# Copy to `.env` and fill in. `docker compose` and the dev scripts both
# read from this file automatically.

# Port the HTTP + WebSocket server listens on.
PORT=8787

# Where the server writes per-room JSON snapshots.
DATA_DIR=./data/rooms

# Rooms idle longer than this are auto-pruned every 6h.
MAX_ROOM_AGE_DAYS=90

# Admin page password. Leave UNSET (or empty) to disable /admin entirely.
# Set this to a non-trivial string to enable the admin UI at /admin.
# ADMIN_PASSWORD=change-me

# Optional site-wide password for all app pages. When set, the startup page
# asks for the password before showing the rest of the app.
# SITE_PASSWORD=change-me-too

# ── Datadog ────────────────────────────────────────────────────────────────
# Telemetry is off unless DD_TRACE_ENABLED=true.
# Requires a Datadog Agent on the host (APM port 8126, DogStatsD port 8125).
# In docker compose, DD_AGENT_HOST defaults to host.docker.internal.

# DD_TRACE_ENABLED=true
# DD_ENV=home
# DD_SITE=datadoghq.com
# DD_TRACE_AGENT_PORT=8126
# DD_VERSION=
